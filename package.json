{
  "name": "blueprint-runtime",
  "version": "0.3.1",
  "description": "Test Make.com (Integromat) scenarios offline: run exported blueprints locally, replay real Make runs and catch broken mappings before deploy. CLI test runner and blueprint validator, CI ready.",
  "keywords": [
    "make",
    "make.com",
    "makecom",
    "integromat",
    "make-scenario",
    "make-blueprint",
    "blueprint",
    "scenario-testing",
    "no-code",
    "low-code",
    "automation",
    "workflow-automation",
    "testing",
    "test-runner",
    "regression-testing",
    "offline",
    "validator",
    "linter",
    "ci",
    "cli"
  ],
  "homepage": "https://github.com/intikhab49/blueprint-runtime#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/intikhab49/blueprint-runtime.git"
  },
  "bugs": {
    "url": "https://github.com/intikhab49/blueprint-runtime/issues"
  },
  "author": "Intikhab Azam",
  "license": "MIT",
  "type": "module",
  "bin": {
    "bpr": "dist/src/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test \"test/**/*.test.ts\"",
    "bpr": "node src/cli.ts",
    "prepare": "tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
